# Ejemplo de archivo .env
# Copiar este archivo a .env y rellenar con tus datos

# ==========================================
# TELEGRAM BOT
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# PROXYS (opcional)
# Formato: ip:puerto o protocolo://ip:puerto
# ==========================================
PROXY_1=
PROXY_2=
PROXY_3=

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==========================================
# BROWSER
# ==========================================
HEADLESS=true
# Ejecutar navegador en background (sin GUI)

BROWSER_TIMEOUT=30
# Timeout en segundos para esperar elementos

# ==========================================
# DELAYS
# ==========================================
SEARCH_RETRY_MIN=60
SEARCH_RETRY_MAX=95
# Delay entre búsquedas en segundos

# ==========================================
# DATABASE
# ==========================================
DB_PATH=./database
# Ruta a la carpeta de base de datos JSON

# ==========================================
# WORKER
# ==========================================
WORKER_TYPE=NIE_SPECIFIED
# Tipo de visa para worker en Docker
# Valores: NIE_SPECIFIED, NIE_NATIONAL, TIE_SPECIFIED, TIE_NATIONAL

WORKER_ID=1
# ID único del worker para logging
