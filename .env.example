# 📝 ПРИМЕР ФАЙЛА .env ДЛЯ CITAS BOT v2.0
# Скопируйте этот файл в .env и заполните свои данные

# ═══════════════════════════════════════════════════════════════════════════════
# 🤖 TELEGRAM BOT
# ═══════════════════════════════════════════════════════════════════════════════

# Получите токен у @BotFather в Telegram
# Инструкция: см. TELEGRAM_BOT_SETUP.md
TELEGRAM_BOT_TOKEN=8575472682:AAFLfrceRr_IRphlNiBsMRfpXkCJV-IbNOU

# Ваш личный Chat ID для уведомлений
# Получите командой: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=356781170

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 PROXYS (опционально)
# Формат: ip:puerto или protocolo://ip:puerto
# ═══════════════════════════════════════════════════════════════════════════════

PROXY_1=
PROXY_2=
PROXY_3=

USE_PROXY=false
# Использовать прокси: true/false

# ═══════════════════════════════════════════════════════════════════════════════
# 📋 LOGGING
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
# Уровни: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=logs/citas.log
# Путь к файлу логов

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 BROWSER
# ═══════════════════════════════════════════════════════════════════════════════

BROWSER_TYPE=chrome
# Тип: chrome, firefox, edge

HEADLESS=true
# Запускать браузер без GUI (в фоне)

BROWSER_TIMEOUT=30
# Timeout в секундах для ожидания элементов

# ═══════════════════════════════════════════════════════════════════════════════
# ⏱️ DELAYS (задержки)
# ═══════════════════════════════════════════════════════════════════════════════

SEARCH_RETRY_MIN=60
SEARCH_RETRY_MAX=95
# Задержка между поисками в секундах

MIN_DELAY=4
MAX_DELAY=7
# Случайная задержка между действиями в секундах

# ═══════════════════════════════════════════════════════════════════════════════
# 🗄️ DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

USERS_DB=database/users.json
# БД пользователей

SEARCH_HISTORY_DB=database/search_history.json
# История поисков

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 WORKER
# ═══════════════════════════════════════════════════════════════════════════════

WORKER_TYPE=NIE_SPECIFIED
# Тип визы для worker в Docker
# Значения: NIE_SPECIFIED, NIE_NATIONAL, TIE_SPECIFIED, TIE_NATIONAL

# ═══════════════════════════════════════════════════════════════════════════════
# 🐛 DEBUGGING
# ═══════════════════════════════════════════════════════════════════════════════

DEBUG=false
# Режим отладки: true/false

SAVE_ERROR_SCREENSHOTS=true
# Сохранять скриншоты ошибок: true/false

WORKER_ID=1
# ID único del worker para logging
